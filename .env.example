# Copy to .env (gitignored) and fill in. Never commit real values.
RUNPOD_API_KEY=
COLDPROBE_FAKE=0
# Loopback only: the API can spend money and has no login.
COLDPROBE_ADDR=127.0.0.1:8080
COLDPROBE_DB=/data/coldprobe.db
COLDPROBE_BUDGET_CAP_USD=2.00
# Optional ceiling on the form's max workers (1..60). Runpod's self-serve limit is 60.
COLDPROBE_MAX_WORKERS=60
COLDPROBE_WORKER_IMAGE=ghcr.io/josh10111/coldprobe-worker:latest
